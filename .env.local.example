# Copie para .env.local (nunca commitar .env.local)
# Obtenha em: Supabase → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anon_aqui

# Server-only (Vercel → Environment Variables, NÃO prefixar com NEXT_PUBLIC_):
# SUPABASE_SERVICE_ROLE_KEY=sua_service_role_aqui
#
# Obrigatório no servidor para assinar a sessão do portal /avaliacao.
# Use um segredo próprio (não reutilize a service role nem chaves NEXT_PUBLIC_).
AVALIACAO_SESSION_SECRET=
#
# Envio de e-mail (Resend) — server-only. NÃO prefixar com NEXT_PUBLIC_.
# RESEND_API_KEY= (obrigatória em produção para envio automático do relatório)
# RESEND_FROM=Navarro Engenharia <relatorios@docs.navarroeng.com.br>
# RESEND_REPLY_TO=contato@navarroeng.com.br
# RESEND_FROM_FATURAS=Navarro Engenharia <financeiro@docs.navarroeng.com.br>
# RESEND_REPLY_TO_FATURAS=atendimento@navarroeng.com.br
#
# Intent de reenvio de fatura por e-mail (opcional; fallback: AVALIACAO_SESSION_SECRET)
# FATURA_REENVIO_SECRET=
# Token efêmero da rota /riscos-relatorio-print (opcional; fallback: AVALIACAO_SESSION_SECRET)
# RISCOS_RELATORIO_PRINT_SECRET=
#
# URL pública da aplicação (opcional; fallback: VERCEL_URL ou host da requisição)
# NEXT_PUBLIC_APP_URL=https://agendamento-exames.vercel.app
# Necessários para o portal /avaliacao validar CPF + código no servidor.
# A service_role NÃO deve ir para o frontend.
#
# Preview interno do Portal do Cliente: em produção o staff escolhe a empresa na tela.
# Fallback local opcional (não usar em produção):
# PORTAL_DEV_CLIENTE_ID=